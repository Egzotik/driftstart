{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftstart-relay",
  "main": "src/server-v04.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "DriftRoom" }, { "name": "RACES", "class_name": "EventRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DriftRoom"] }, { "tag": "v2", "new_sqlite_classes": ["EventRoom"] }],
  "observability": { "enabled": false }
}
