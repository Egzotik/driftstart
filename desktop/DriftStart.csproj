<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>DriftStart</AssemblyName>
    <Version>1.5.0</Version><Product>DriftStart</Product><Description>Discord drift groups, synchronized start lights and tournament control</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\DriftStart.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><Compile Remove="MainWindow.xaml.cs"/><Page Remove="MainWindow.xaml"/></ItemGroup>
</Project>
