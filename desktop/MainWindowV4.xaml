<Window x:Class="DriftStart.MainWindowV4" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriftStart — Race Control" Width="1493" Height="840" MinWidth="1180" MinHeight="720" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI Variable Display" WindowStartupLocation="CenterScreen">
 <Grid x:Name="ShellGrid" Margin="8" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
  <Border Background="#0B0C10" BorderBrush="#303138" BorderThickness="1" CornerRadius="12"/>
  <Grid Margin="1"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border Background="#111218" BorderBrush="#25262D" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
    <Grid Margin="18,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M0,0 L22,0 L15,16 L-7,16 Z M28,0 L36,0 L29,16 L21,16 Z" Fill="#F20D4F" Width="38" Height="16" Stretch="Uniform" Margin="4,0,12,0"/><TextBlock Text="DRIFTSTART" FontSize="14" FontWeight="Black"/><TextBlock Text="RACE CONTROL" FontSize="10" Foreground="#717581" Margin="16,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#657183" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Не подключено" FontSize="11" Foreground="#B5B7C0" VerticalAlignment="Center" Margin="0,0,22,0"/><Button Content="—" Width="32" Height="28" Padding="0" Click="Minimize_Click"/><Button Content="×" Width="32" Height="28" Padding="0" Margin="5,0,0,0" Click="Close_Click"/></StackPanel></Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="#101116" BorderBrush="#25262D" BorderThickness="0,0,1,0"><Grid Margin="12,20,12,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource Label}" Margin="12,0,0,14"/><Button x:Name="NavLobby" Content="01   Моя группа" Style="{StaticResource Nav}" Click="LobbyPage_Click"/><Button x:Name="NavRace" Content="02   Стартовая зона" Style="{StaticResource Nav}" Click="RacePage_Click"/><Button x:Name="NavEvents" Content="03   Турнир" Style="{StaticResource Nav}" Click="Events_Click"/><Border Height="1" Background="#25262D" Margin="12,12"/><Button x:Name="NavProfile" Content="04   Профиль пилота" Style="{StaticResource Nav}" Click="ProfilePage_Click"/><Button x:Name="NavHud" Content="05   HUD и клавиши" Style="{StaticResource Nav}" Click="HudPage_Click"/></StackPanel>
     <StackPanel Grid.Row="2"><Border Background="#18191F" CornerRadius="8" Padding="13"><StackPanel><TextBlock x:Name="SideUser" Text="Discord" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SideRole" Text="Авторизация…" Foreground="#858996" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SideRoom" Text="Нет группы" Foreground="#FF4B7D" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse Width="6" Height="6" Fill="#59E26F" Margin="0,0,6,0"/><TextBlock x:Name="GlobalOnline" Text="DriftStart онлайн: —" Foreground="#A5A5AA" FontSize="10"/></StackPanel></StackPanel></Border><Button Content="Выйти из Discord" Background="Transparent" BorderThickness="0" Foreground="#858996" Padding="8" FontSize="11" Margin="0,7,0,0" Click="Logout_Click"/></StackPanel>
    </Grid></Border>
    <Grid x:Name="MainContent" Grid.Column="1" Margin="22,18,22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18"><TextBlock x:Name="PageTitle" Text="Моя группа" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="MAJESTIC / DRIFT COMPETITION" HorizontalAlignment="Right" Foreground="#626775" FontSize="10" VerticalAlignment="Center"/></DockPanel>
     <Grid x:Name="PageSurface" Grid.Row="1">
      <Grid x:Name="LobbyPage"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Собери свою команду" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Одна группа. Общий старт. Свой турнир." Foreground="#858996" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,18"/><TextBlock Text="НАЗВАНИЕ ГРУППЫ" Style="{StaticResource Label}"/><TextBox x:Name="RoomNameInput" Text="Night Drift" MaxLength="48"/><Button Content="+  Создать группу" Style="{StaticResource Primary}" Margin="0,12,0,0" Click="CreateRoom_Click"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Есть приглашение?" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Введите шестизначный код группы" FontSize="12" Foreground="#858996" Margin="0,7,0,10"/><TextBox x:Name="JoinCodeInput" CharacterCasing="Upper" MaxLength="6" FontSize="20" FontWeight="Bold"/><Button Content="Присоединиться  →" Margin="0,10,0,0" Click="JoinRoom_Click"/></StackPanel></Border><TextBlock Text="МОИ ГРУППЫ" Style="{StaticResource Label}" Margin="2,20,0,10"/><StackPanel x:Name="RoomsList"/></StackPanel></ScrollViewer>
       <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="АКТИВНАЯ ГРУППА" Style="{StaticResource Label}"/><TextBlock x:Name="CurrentRoomName" Text="Выберите группу" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CurrentRoomRole" Text="Создайте группу или войдите по приглашению" Foreground="#858996" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#24131D" BorderBrush="#522037" BorderThickness="1" CornerRadius="7" Padding="14,10"><StackPanel><TextBlock Text="КОД ПРИГЛАШЕНИЯ" FontSize="9" Foreground="#B8889A"/><TextBlock x:Name="CurrentRoomCode" Text="— — — — — —" FontFamily="Consolas" Foreground="#FF4B7D" FontSize="22" FontWeight="Bold" Margin="0,4,0,5"/><Button Content="Копировать код" Padding="8,5" FontSize="10" Click="CopyCode_Click"/></StackPanel></Border></Grid><DockPanel Grid.Row="1" Margin="0,22,0,12"><TextBlock x:Name="GroupMemberCount" Text="УЧАСТНИКИ ГРУППЫ" Style="{StaticResource Label}" VerticalAlignment="Center"/><Button Content="↻ Обновить" HorizontalAlignment="Right" Padding="10,6" FontSize="11" Click="RefreshRooms_Click"/></DockPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ContentControl x:Name="GroupMembersHost"/></ScrollViewer><Button Grid.Row="3" Content="Расформировать группу" Foreground="#C8758C" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,12,0,0" FontSize="11" Click="DisbandRoom_Click"/></Grid></Border>
      </Grid>
      <Grid x:Name="RacePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="●  LIVE START" FontSize="10" FontWeight="Bold" Foreground="#FF4B7D"/><TextBlock x:Name="SyncLabel" Text="Синхронизация…" HorizontalAlignment="Right" Foreground="#858996" FontSize="10"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SignalText" Text="—" FontSize="64" FontWeight="Black"/><TextBlock x:Name="SignalHint" Text="Выберите группу" FontSize="12" Foreground="#858996"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="RedLamp" Width="23" Height="23" Fill="#252C36" Margin="0,0,10,0"/><Ellipse x:Name="AmberLamp" Width="23" Height="23" Fill="#252C36" Margin="0,0,10,0"/><Ellipse x:Name="GreenLamp" Width="23" Height="23" Fill="#252C36"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="F8   ЗАПУСТИТЬ" Style="{StaticResource Primary}" Click="Start_Click"/><Button x:Name="CancelButton" Grid.Column="1" Content="F7   ОТМЕНА" Margin="10,0,0,0" Click="Cancel_Click"/></Grid></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПАРАМЕТРЫ ЗАЕЗДА" Style="{StaticResource Label}"/><TextBlock Text="Кто на старте" FontSize="12" Foreground="#B3B7C1" Margin="0,7,0,5"/><TextBox x:Name="RoundInput" Text="Свободный заезд" MaxLength="48"/><TextBlock Text="ОБРАТНЫЙ ОТСЧЁТ" Style="{StaticResource Label}" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="CountdownSeconds" Text="6" MaxLength="2" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="секунд · от 1 до 60" FontSize="11" Foreground="#858996" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><Button Content="Настроить HUD и клавиши  ↗" Background="Transparent" BorderThickness="0" Foreground="#FF4B7D" Padding="0,14,0,0" HorizontalAlignment="Left" FontSize="11" Click="HudPage_Click"/></StackPanel></Border></Grid>
       <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock x:Name="PilotCount" Text="0 пилотов" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ПОДКЛЮЧЕНЫ К СТАРТУ" FontSize="10" Foreground="#626775" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="260"><WrapPanel x:Name="Roster"/></ScrollViewer></Grid></Border>
      </Grid>
      <ScrollViewer x:Name="HudPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Стартовый HUD" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Пять огней · прозрачный фон · поверх игры" FontSize="12" Foreground="#858996" Margin="0,6,0,18"/><Border Height="105" Background="#090A0D" CornerRadius="8" Margin="0,0,0,14"><Grid><Path Data="M0,12 L22,0 L330,0 L314,76 L0,76 Z" Fill="#202129" Width="330" Height="76" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="18" Height="18" Fill="#F20D4F" Margin="0,0,10,0"/><Ellipse Width="18" Height="18" Fill="#F20D4F" Margin="0,0,10,0"/><Ellipse Width="18" Height="18" Fill="#F4B43A" Margin="0,0,10,0"/><Ellipse Width="18" Height="18" Fill="#383B45" Margin="0,0,10,0"/><Ellipse Width="18" Height="18" Fill="#383B45"/><TextBlock Text="03" FontSize="28" FontWeight="Black" Margin="24,-9,0,0"/></StackPanel></Grid></Border><CheckBox x:Name="ShowHudCheck" Content="Показывать стартовый HUD" IsChecked="True" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><CheckBox x:Name="MoveHudCheck" Content="Разрешить перемещение мышью" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><TextBlock Text="МАСШТАБ" Style="{StaticResource Label}" Margin="0,16,0,7"/><Slider x:Name="HudScale" Minimum="0.7" Maximum="1.5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="HudSlider_Changed"/><TextBlock Text="НЕПРОЗРАЧНОСТЬ" Style="{StaticResource Label}" Margin="0,16,0,7"/><Slider x:Name="HudOpacity" Minimum="0.45" Maximum="1" Value="0.95" ValueChanged="HudSlider_Changed"/><Button Content="Вернуть HUD в центр" Margin="0,18,0,0" Click="ResetHud_Click"/><TextBlock Text="Для отображения поверх игры используйте оконный режим без рамки." FontSize="11" Foreground="#858996" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Настройки сохраняются автоматически" Foreground="#858996" FontSize="12" Margin="0,6,0,18"/><TextBlock Text="ЗАПУСТИТЬ ОТСЧЁТ" Style="{StaticResource Label}"/><ComboBox x:Name="StartKeyPicker" SelectionChanged="Hotkey_Changed"/><TextBlock Text="ОТМЕНИТЬ СТАРТ" Style="{StaticResource Label}" Margin="0,14,0,7"/><ComboBox x:Name="CancelKeyPicker" SelectionChanged="Hotkey_Changed"/></StackPanel></Border></Grid></ScrollViewer>
      <Grid x:Name="ProfilePage" Visibility="Collapsed" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Карточка пилота" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Эти данные увидят ваша группа и судьи" FontSize="12" Foreground="#858996" Margin="0,6,0,20"/><TextBlock Text="ИГРОВОЙ НИК" Style="{StaticResource Label}"/><TextBox x:Name="ProfileNickname" MaxLength="32"/><TextBlock Text="СТАТИК" Style="{StaticResource Label}" Margin="0,14,0,7"/><TextBox x:Name="ProfileStatic" MaxLength="10"/><TextBlock Text="АВТОМОБИЛЬ" Style="{StaticResource Label}" Margin="0,14,0,7"/><ComboBox x:Name="ProfileVehicle" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="ProfileVehicle_Changed"/><TextBlock Text="Найдите в списке или введите своё название" FontSize="11" Foreground="#858996" Margin="0,7,0,0"/><Button Content="Сохранить профиль  →" Style="{StaticResource Primary}" Margin="0,20,0,0" Click="SaveProfile_Click"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ВАШ АВТОМОБИЛЬ" Style="{StaticResource Label}"/><Grid Grid.Row="1" MinHeight="240"><Path Data="M0,100 L160,0 L320,0 L160,100 Z" Fill="#181A22" Stretch="Uniform" Opacity="0.8"/><Image x:Name="ProfileVehicleImage" Stretch="Uniform" Margin="20"/></Grid><StackPanel Grid.Row="2"><TextBlock x:Name="ProfileVehicleName" Text="Выберите автомобиль" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="MAJESTIC RP / РОССИЯ ОНЛАЙН" FontSize="10" Foreground="#626775" Margin="0,6,0,0"/></StackPanel></Grid></Border></Grid>
      <Grid x:Name="EventsPage" Visibility="Collapsed"><ContentControl x:Name="EventHost"/></Grid>
     </Grid>
    </Grid>
   </Grid>
   <Border Grid.Row="2" Background="#101116" BorderBrush="#25262D" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11"><Grid Margin="16,0"><TextBlock x:Name="Message" Text="Запускаем DriftStart…" Foreground="#858996" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/><TextBlock Text="2.0.0  /  DRIFTSTART" Foreground="#555A68" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
  <Border x:Name="LoginOverlay" Background="#0B0C10" Panel.ZIndex="20" Margin="1,49,1,33"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#111218" BorderBrush="#25262D" BorderThickness="0,0,1,0"><Grid Margin="48"><Path Data="M0,100 L170,0 L400,0 L230,100 Z M0,230 L170,130 L400,130 L230,230 Z M0,360 L170,260 L400,260 L230,360 Z" Fill="#F20D4F" Opacity="0.09" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="DRIFTSTART / COMPETITION" Foreground="#FF4B7D" FontSize="11" FontWeight="Bold"/><TextBlock Text="Один старт.&#x0a;Общий ритм." FontSize="48" FontWeight="Black" LineHeight="54" Margin="0,20,0,22"/><TextBlock Text="Управляйте заездами, судейством&#x0a;и турнирами вместе со своей командой." Foreground="#999DA9" FontSize="14" LineHeight="23"/><Border Height="1" Background="#34303A" Margin="0,32,0,18"/><WrapPanel><TextBlock Text="01  ГРУППЫ" FontSize="10" Foreground="#888C99" Margin="0,0,22,10"/><TextBlock Text="02  LIVE START" FontSize="10" Foreground="#888C99" Margin="0,0,22,10"/><TextBlock Text="03  ТУРНИРЫ" FontSize="10" Foreground="#888C99"/></WrapPanel></StackPanel></Grid></Border><Grid Grid.Column="1" Margin="42"><StackPanel MaxWidth="365" VerticalAlignment="Center"><Border Background="#252039" CornerRadius="12" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock Text="DS" FontSize="20" FontWeight="Black" Foreground="#BCABFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="LoginTitle" Text="С возвращением" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="LoginSubtitle" Text="Проверяем сохранённый вход." Foreground="#858996" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,22"/><ProgressBar x:Name="LoginProgress" Height="3" IsIndeterminate="True" Margin="0,0,0,16" Foreground="#F20D4F" Background="#26232D"/><Button x:Name="LoginButton" Content="Продолжить через Discord  →" Style="{StaticResource Primary}" Click="Login_Click" IsEnabled="False" Height="44"/><TextBlock x:Name="LoginMessage" Text="Подключаемся…" Foreground="#999DA9" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"/><TextBlock Text="Запрашиваем только имя и Discord ID.&#x0a;Пароль остаётся в Discord." FontSize="10" Foreground="#5E6371" LineHeight="17" Margin="0,28,0,0"/></StackPanel></Grid></Grid></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Panel.ZIndex="30"><Button Content="—" Width="32" Height="28" Padding="0" Click="Minimize_Click"/><Button Content="×" Width="32" Height="28" Padding="0" Margin="5,0,0,0" Click="Close_Click"/></StackPanel>
  <Border x:Name="UpdateBar" VerticalAlignment="Bottom" Height="44" Margin="1,0,1,1" Background="#19151E" BorderBrush="#F20D4F" BorderThickness="0,1,0,0" Panel.ZIndex="50" Visibility="Collapsed"><Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateBarText" Text="Скачиваем обновление…" FontSize="11" VerticalAlignment="Center"/><ProgressBar x:Name="UpdateProgress" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Margin="12,0" VerticalAlignment="Center"/><TextBlock x:Name="UpdatePercent" Grid.Column="2" Text="0%" Foreground="#FF4B7D" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
