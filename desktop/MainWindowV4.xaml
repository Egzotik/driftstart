<Window x:Class="DriftStart.MainWindowV4" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriftStart — Drift Control" Width="1244" Height="844" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ResizeMode="NoResize" FontFamily="Segoe UI Variable Display" WindowStartupLocation="CenterScreen">
 <Grid x:Name="ShellGrid" Width="1220" Height="820" MouseLeftButtonDown="Shell_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Path Grid.ColumnSpan="2" Data="M 18,0 L 1202,0 L 1220,18 L 1220,802 L 1202,820 L 18,820 L 0,802 L 0,18 Z" Fill="#F2070708" Stroke="#2E2E31" StrokeThickness="1"/>
  <Path Grid.ColumnSpan="2" Data="M 18,0 L 480,0 L 462,5 L 14,5 Z" Fill="#F20D4F"/>
  <Border x:Name="Sidebar" Background="Transparent" BorderBrush="#332642" BorderThickness="0,0,1,0" Margin="8,8,0,8"><Grid Margin="20,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" Background="#F20D4F" CornerRadius="2"><TextBlock Text="DS" Foreground="#FFFFFF" FontWeight="Black" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,1,0,0"><TextBlock Text="DRIFTSTART" FontWeight="Bold" FontSize="17"/><TextBlock Text="MAJESTIC RACE SYSTEM" Foreground="#77777C" FontSize="9"/></StackPanel></StackPanel><Border Height="1" Background="#29292C" Margin="0,24,0,22"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="УПРАВЛЕНИЕ" Style="{StaticResource Label}" Margin="12,0,0,12"/><Button x:Name="NavLobby" Content="МОЯ ГРУППА" Style="{StaticResource Nav}" Click="LobbyPage_Click"/><Button x:Name="NavRace" Content="СТАРТОВАЯ ЗОНА" Style="{StaticResource Nav}" Click="RacePage_Click"/><Button x:Name="NavEvents" Content="ТУРНИР" Style="{StaticResource Nav}" Click="Events_Click"/><Button x:Name="NavProfile" Content="ПРОФИЛЬ ПИЛОТА" Style="{StaticResource Nav}" Click="ProfilePage_Click"/><Button x:Name="NavHud" Content="HUD И КЛАВИШИ" Style="{StaticResource Nav}" Click="HudPage_Click"/></StackPanel>
   <StackPanel Grid.Row="2"><Border Background="#111113" BorderBrush="#303034" BorderThickness="1" CornerRadius="2" Padding="14"><StackPanel><TextBlock x:Name="SideUser" Text="Discord" FontWeight="SemiBold"/><TextBlock x:Name="SideRole" Text="Авторизация…" Foreground="#88888D" FontSize="11" Margin="0,3,0,0"/><TextBlock x:Name="SideRoom" Text="Нет группы" Foreground="#F20D4F" FontSize="10" Margin="0,9,0,0"/></StackPanel></Border><Button Content="Выйти из Discord" Background="Transparent" BorderThickness="0" Foreground="#88888D" Padding="8" Margin="0,8,0,0" Click="Logout_Click"/><TextBlock Text="1.4.0 · AUTO UPDATE" Foreground="#5F5F64" FontSize="10" Margin="10,6,0,0"/></StackPanel>
  </Grid></Border>
  <Grid x:Name="MainContent" Grid.Column="1" Margin="36,34,36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,26"><StackPanel><TextBlock Text="MAJESTIC DRIFT CONTROL" Foreground="#F20D4F" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Моя группа" FontSize="31" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#121214" BorderBrush="#303034" BorderThickness="1" CornerRadius="2" Padding="14,9" Margin="0,0,86,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#657183" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Не подключено" FontSize="12"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="LobbyPage"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
     <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Создать группу" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Один аккаунт может создать одну группу. Лидер назначает помощников и судей." Foreground="#85858A" TextWrapping="Wrap" Margin="0,9,0,22"/><TextBlock Text="НАЗВАНИЕ ГРУППЫ" Style="{StaticResource Label}"/><TextBox x:Name="RoomNameInput" Text="Night Drift" MaxLength="48"/><Button Content="СОЗДАТЬ ГРУППУ" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="CreateRoom_Click"/><Button Content="РАСФОРМИРОВАТЬ ВЫБРАННУЮ" Foreground="#F20D4F" Margin="0,10,0,0" Click="DisbandRoom_Click"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Войти по коду" FontSize="19" FontWeight="SemiBold"/><TextBox x:Name="JoinCodeInput" CharacterCasing="Upper" MaxLength="6" FontSize="24" FontWeight="Bold" Margin="0,16,0,12"/><Button Content="ПРИСОЕДИНИТЬСЯ" Click="JoinRoom_Click"/></StackPanel></Border></StackPanel>
     <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="МОИ ГРУППЫ" Style="{StaticResource Label}"/><Button Content="Обновить" HorizontalAlignment="Right" Padding="10,7" FontSize="11" Click="RefreshRooms_Click"/></Grid><Border Grid.Row="1" Background="#0B0F15" CornerRadius="12" Padding="16" Margin="0,12,0,16"><Grid><StackPanel><TextBlock x:Name="CurrentRoomName" Text="Группа не выбрана" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CurrentRoomRole" Text="Создай группу или введи код" Foreground="#8190A3" FontSize="12"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="КОД ИНВАЙТА" Foreground="#708096" FontSize="9"/><TextBlock x:Name="CurrentRoomCode" Text="— — — — — —" Foreground="#C9FF35" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/><Button Content="Копировать" Padding="8,4" FontSize="10" Margin="0,5,0,0" Click="CopyCode_Click"/></StackPanel></Grid></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RoomsList"/></ScrollViewer></Grid></Border>
    </Grid>
    <Grid x:Name="RacePage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="LIVE START" Foreground="#A96DFF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="SyncLabel" Text="Синхронизация…" HorizontalAlignment="Right" Foreground="#968AA3" FontSize="11"/></Grid><Grid Grid.Row="1" Margin="0,20,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SignalText" Text="—" FontSize="80" FontWeight="Bold"/><TextBlock x:Name="SignalHint" Text="Выберите группу" Foreground="#A69BAD" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Ellipse x:Name="RedLamp" Width="32" Height="32" Fill="#252C36" Margin="0,0,0,12"/><Ellipse x:Name="AmberLamp" Width="32" Height="32" Fill="#252C36" Margin="0,0,0,12"/><Ellipse x:Name="GreenLamp" Width="32" Height="32" Fill="#252C36"/></StackPanel></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="F8   ЗАПУСТИТЬ" Style="{StaticResource Primary}" Click="Start_Click"/><Button x:Name="CancelButton" Grid.Column="2" Content="F7   ОТМЕНА" MinWidth="130" Click="Cancel_Click"/><CheckBox x:Name="ReadyCheck" Grid.ColumnSpan="3" Content="Я готов к старту" Visibility="Collapsed" Checked="Ready_Changed" Unchecked="Ready_Changed"/></Grid></Grid></Border>
     <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПАРАМЕТРЫ ЗАЕЗДА" Style="{StaticResource Label}"/><TextBox x:Name="RoundInput" Text="Свободный заезд" MaxLength="48"/><TextBlock Text="ОТСЧЁТ · 1–60 СЕКУНД" Style="{StaticResource Label}" Margin="0,18,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CountdownSeconds" Text="6" MaxLength="2" FontSize="22" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="СЕК" Foreground="#77777C" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><TextBlock Text="F8 — СТАРТ     F7 — ОТМЕНА" Foreground="#F20D4F" FontSize="10" FontWeight="Bold" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="PilotCount" Text="0 пилотов" FontSize="18" FontWeight="SemiBold"/><ScrollViewer Grid.Row="1" MaxHeight="330" Margin="0,16,0,0"><StackPanel x:Name="Roster"/></ScrollViewer></Grid></Border></StackPanel>
    </Grid>
    <Grid x:Name="HudPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HUD поверх игры" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Пять стартовых огней. Работает в оконном режиме и без рамки." Foreground="#85858A" Margin="0,10,0,20"/><CheckBox x:Name="ShowHudCheck" Content="Показывать HUD" IsChecked="True" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><CheckBox x:Name="MoveHudCheck" Content="Режим перемещения" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><TextBlock Text="МАСШТАБ" Style="{StaticResource Label}" Margin="0,22,0,8"/><Slider x:Name="HudScale" Minimum="0.7" Maximum="1.5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="HudSlider_Changed"/><TextBlock Text="НЕПРОЗРАЧНОСТЬ" Style="{StaticResource Label}" Margin="0,22,0,8"/><Slider x:Name="HudOpacity" Minimum="0.45" Maximum="1" Value="0.95" ValueChanged="HudSlider_Changed"/><Button Content="ВЕРНУТЬ HUD В ЦЕНТР" HorizontalAlignment="Left" Margin="0,24,0,0" Click="ResetHud_Click"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Горячие клавиши" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="СТАРТ" Style="{StaticResource Label}" Margin="0,20,0,8"/><ComboBox x:Name="StartKeyPicker" SelectionChanged="Hotkey_Changed"/><TextBlock Text="ОТМЕНА" Style="{StaticResource Label}" Margin="0,18,0,8"/><ComboBox x:Name="CancelKeyPicker" SelectionChanged="Hotkey_Changed"/><TextBlock Text="Можно выбрать F1–F12. Одинаковая клавиша для двух действий запрещена. Настройка применяется сразу и сохраняется." Foreground="#85858A" TextWrapping="Wrap" LineHeight="20" Margin="0,18,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="ProfilePage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПРОФИЛЬ ПИЛОТА" Style="{StaticResource Label}"/><TextBlock Text="Данные, которые увидят судьи и участники вашей группы." Foreground="#85858A" TextWrapping="Wrap" Margin="0,0,0,24"/><TextBlock Text="ИГРОВОЙ НИК" Style="{StaticResource Label}"/><TextBox x:Name="ProfileNickname" MaxLength="32"/><TextBlock Text="СТАТИК" Style="{StaticResource Label}" Margin="0,18,0,8"/><TextBox x:Name="ProfileStatic" MaxLength="10"/><TextBlock Text="АВТОМОБИЛЬ" Style="{StaticResource Label}" Margin="0,18,0,8"/><ComboBox x:Name="ProfileVehicle" IsEditable="False" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="ProfileVehicle_Changed" Padding="12"/><Button Content="СОХРАНИТЬ ПРОФИЛЬ" Style="{StaticResource Primary}" Margin="0,24,0,0" Click="SaveProfile_Click"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><Border Height="220" Background="#080809" BorderBrush="#29292C" BorderThickness="1"><Image x:Name="ProfileVehicleImage" Stretch="Uniform" Margin="18"/></Border><TextBlock x:Name="ProfileVehicleName" Text="Выберите автомобиль" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock Text="Изображения и названия загружаются из публичного каталога Majestic RP Wiki." Foreground="#77777C" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="EventsPage" Visibility="Collapsed"><ContentControl x:Name="EventHost"/></Grid>
   </Grid>
   <TextBlock Grid.Row="2" x:Name="Message" Text="Запускаем авторизацию Discord…" Foreground="#8190A3" FontSize="11" TextWrapping="Wrap" Margin="2,15,0,0"/>
  </Grid>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,14,0" Panel.ZIndex="30"><Button Content="—" Width="34" Height="26" Padding="0" Click="Minimize_Click"/><Button Content="×" Width="34" Height="26" Padding="0" Margin="6,0,0,0" Click="Close_Click"/></StackPanel>
  <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#F2070708" Panel.ZIndex="20" Margin="8"><Grid><Border Width="520" VerticalAlignment="Center" Background="#101012" BorderBrush="#303034" BorderThickness="1" CornerRadius="2" Padding="38"><StackPanel><Border Width="56" Height="56" Background="#F20D4F" CornerRadius="2" HorizontalAlignment="Left"><TextBlock Text="DS" Foreground="#FFFFFF" FontWeight="Black" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Войди через Discord" FontSize="30" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="Так группа понимает, кто лидер, судья и пилот. Запрашивается только имя и Discord ID." Foreground="#8A8A8F" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,24"/><Button x:Name="LoginButton" Content="Продолжить через Discord  →" Style="{StaticResource Primary}" Click="Login_Click"/><TextBlock x:Name="LoginMessage" Text="Проверяем сохранённую сессию…" Foreground="#7A7A7F" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border></Grid></Border>
 </Grid>
</Window>
