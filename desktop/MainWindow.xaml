<Window x:Class="DriftStart.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriftStart — Race Control" Width="1160" Height="840" MinWidth="1020" MinHeight="760" Background="#0C121B" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101721" BorderBrush="#242E3D" BorderThickness="0,0,1,0" Padding="22,28">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" Background="#74E5E0" CornerRadius="10" Margin="0,0,10,0"><TextBlock Text="D/" Foreground="#0C2730" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="DRIFTSTART" FontSize="17" FontWeight="Bold"/><TextBlock Text="RACE CONTROL" FontSize="9" Foreground="#697C92"/></StackPanel></StackPanel><TextBlock Text="ТВОЙ СТАРТ. ОДИН МОМЕНТ." FontSize="9" Foreground="#728297" Margin="0,19,0,35"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="СЕССИЯ" Style="{StaticResource Label}" Margin="12,0,0,14"/><Button x:Name="NavRace" Content="◉   Стартовая вышка" Style="{StaticResource Nav}" Click="RacePage_Click"/><Button Content="◇   Турниры и судьи" Style="{StaticResource Nav}" Click="Events_Click"/><Button x:Name="NavConnect" Content="↗   Подключение" Style="{StaticResource Nav}" Click="ConnectPage_Click"/><Button x:Name="NavHud" Content="▣   Настройки HUD" Style="{StaticResource Nav}" Click="HudPage_Click"/></StackPanel>
    <StackPanel Grid.Row="2"><Border Background="#172430" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="ОБЩИЙ СИГНАЛ" FontSize="10" Foreground="#74E5E0" FontWeight="Bold"/><TextBlock Text="Судья задаёт момент.&#x0a;Пилоты видят старт." FontSize="11" Foreground="#91A3B7" Margin="0,6,0,0" LineHeight="18"/></StackPanel></Border><TextBlock Text="0.3.0  /  DISCORD" FontSize="10" Foreground="#5F7086" Margin="10,20,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,26,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,25"><StackPanel><TextBlock x:Name="PageEyebrow" Text="DRIFT EVENT / LIVE SESSION" Style="{StaticResource Label}"/><TextBlock x:Name="PageTitle" Text="Стартовая вышка" FontSize="30" FontWeight="SemiBold"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1B2634" CornerRadius="20" Padding="15,10"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#6F8095" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Не подключено" FontSize="12"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="RacePage">
     <Grid.RowDefinitions><RowDefinition Height="326"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B2A39" Offset="0"/><GradientStop Color="#131B28" Offset="0.8"/></LinearGradientBrush></Border.Background><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><TextBlock Text="СТАРТОВЫЙ СИГНАЛ" Style="{StaticResource Label}"/><TextBlock x:Name="TransportLabel" Text="WSS" Foreground="#74E5E0" FontSize="10" HorizontalAlignment="Right"/></Grid>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SignalText" Text="—" FontSize="66" FontWeight="SemiBold" Foreground="#74E5E0"/><TextBlock x:Name="SignalHint" Text="Подключитесь к комнате" FontSize="13" Foreground="#9CADC0" Margin="2,0,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Ellipse x:Name="RedLamp" Width="28" Height="28" Fill="#2C3746" Margin="0,0,0,10"/><Ellipse x:Name="AmberLamp" Width="28" Height="28" Fill="#2C3746" Margin="0,0,0,10"/><Ellipse x:Name="GreenLamp" Width="28" Height="28" Fill="#2C3746"/></StackPanel></Grid>
       <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="StartButton" Content="Запустить отсчёт  →" Style="{StaticResource Primary}" Click="Start_Click" IsEnabled="False"/><Button x:Name="CancelButton" Grid.Column="1" Content="Стоп" Margin="10,0,0,0" Click="Cancel_Click" IsEnabled="False"/><CheckBox x:Name="ReadyCheck" Content="Я готов к старту" VerticalAlignment="Center" Visibility="Collapsed" Checked="Ready_Changed" Unchecked="Ready_Changed"/></Grid>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ПАРАМЕТРЫ ЗАЕЗДА" Style="{StaticResource Label}"/><TextBlock Text="Название" FontSize="12" Foreground="#9CADC0" Margin="0,10,0,8"/><TextBox x:Name="RoundInput" Text="Пара 01 / проезд 1" MaxLength="48"/><TextBlock Text="Отсчёт" FontSize="12" Foreground="#9CADC0" Margin="0,16,0,8"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="Delay6" Content="6 сек" IsChecked="True"/><RadioButton x:Name="Delay10" Content="10 сек"/></StackPanel><Border Background="#0F1721" CornerRadius="9" Padding="12" Margin="0,22,0,0"><StackPanel><TextBlock x:Name="SyncLabel" Text="Часы не синхронизированы" FontSize="11" Foreground="#B6C6D6"/><TextBlock Text="Единое время старта для всех" FontSize="10" Foreground="#657B91" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></Border>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Пилоты в комнате" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PilotCount" Text="0 участников" FontSize="12" Foreground="#8295AC" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" Margin="0,18,0,8" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Roster"><TextBlock Text="Участники появятся после подключения" Foreground="#76899F" FontSize="13" Margin="0,20,0,0"/></StackPanel></ScrollViewer><Grid Grid.Row="2"><Button x:Name="CopyInviteButton" Content="Скопировать приглашение" HorizontalAlignment="Left" Padding="12,8" FontSize="11" Click="CopyInvite_Click"/><Button x:Name="PruneButton" Content="Убрать отключённых" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#95A7BC" FontSize="11" Padding="8" Click="Prune_Click"/></Grid></Grid></Border>
    </Grid>
    <Grid x:Name="ConnectPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Присоединиться к комнате" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,24"/><TextBlock Text="АДРЕС СЕРВЕРА" Style="{StaticResource Label}"/><TextBox x:Name="UrlInput" Margin="0,0,0,18"/><TextBlock Text="КОД КОМНАТЫ" Style="{StaticResource Label}"/><TextBox x:Name="RoomInput" MaxLength="128" Margin="0,0,0,18"/><TextBlock Text="DISCORD-АККАУНТ" Style="{StaticResource Label}"/><TextBox x:Name="NameInput" Text="Войдите через Discord" IsReadOnly="True" MaxLength="100" Margin="0,0,0,18"/><StackPanel Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,20"><RadioButton x:Name="RolePlayer" Content="Пилот" IsChecked="True" Checked="Role_Changed"/><RadioButton x:Name="RoleJudge" Content="Судья" Checked="Role_Changed"/></StackPanel><StackPanel x:Name="JudgeKeyPanel" Visibility="Collapsed"><TextBlock Text="КЛЮЧ СУДЬИ" Style="{StaticResource Label}"/><PasswordBox x:Name="JudgeKeyInput" Margin="0,0,0,18"/></StackPanel><Button x:Name="ConnectButton" Content="Войти через Discord  →" Style="{StaticResource Primary}" Click="Connect_Click"/></StackPanel></Border><StackPanel Grid.Column="2" Margin="0,15,0,0"><TextBlock Text="Один адрес.&#x0a;Один старт." FontSize="28" FontWeight="SemiBold" LineHeight="37"/><TextBlock Text="Организатор отправляет адрес и код комнаты. Подключитесь, включите HUD и подтвердите готовность." TextWrapping="Wrap" Foreground="#94A6BB" FontSize="13" LineHeight="22" Margin="0,18,0,24"/><Button Content="Вставить приглашение" Click="PasteInvite_Click"/><Button Content="Выйти из Discord" Click="Logout_Click" Margin="0,10,0,0"/><Button Content="Открыть файл доступа" Click="ImportProfile_Click" Margin="0,10,0,0"/><Border Background="#142832" CornerRadius="12" Padding="18" Margin="0,25,0,0"><TextBlock Text="Роль выдаёт владелец в разделе «Турниры и судьи». Файл доступа организатора нужен один раз для привязки владельца." TextWrapping="Wrap" Foreground="#90C7CA" FontSize="12" LineHeight="20"/></Border></StackPanel></Grid>
    <Border x:Name="HudPage" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Только важное поверх игры" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Светофор пропускает клики. Используйте оконный режим GTA или режим без рамки." TextWrapping="Wrap" Foreground="#91A3B7" Margin="0,12,0,20"/><CheckBox x:Name="ShowHudCheck" Content="Показывать HUD" IsChecked="True" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><CheckBox x:Name="MoveHudCheck" Content="Режим перемещения — перетащить HUD мышью" Checked="HudSettings_Changed" Unchecked="HudSettings_Changed"/><TextBlock Text="МАСШТАБ" Style="{StaticResource Label}" Margin="0,25,0,12"/><Slider x:Name="HudScale" Minimum="0.7" Maximum="1.5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="HudSlider_Changed"/><TextBlock Text="НЕПРОЗРАЧНОСТЬ" Style="{StaticResource Label}" Margin="0,25,0,12"/><Slider x:Name="HudOpacity" Minimum="0.45" Maximum="1" Value="0.95" ValueChanged="HudSlider_Changed"/><Button Content="Вернуть HUD в центр" HorizontalAlignment="Left" Margin="0,28,0,0" Click="ResetHud_Click"/></StackPanel></Border>
   </Grid>
   <TextBlock Grid.Row="2" x:Name="Message" Text="Подключитесь к серверу, чтобы начать сессию." Foreground="#8194AA" TextWrapping="Wrap" FontSize="11" Margin="2,18,0,0"/>
  </Grid>
 </Grid>
</Window>
