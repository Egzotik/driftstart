<Application x:Class="DriftStart.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#F20D4F"/><SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F6F3FF"/><Setter Property="FontFamily" Value="Segoe UI Variable Display"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#85858A"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#E60D0D0F"/><Setter Property="BorderBrush" Value="#2A2A2D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="24"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="Background" Value="#19191C"/><Setter Property="BorderBrush" Value="#36363A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#F20D4F"/><Setter TargetName="B" Property="Background" Value="#242427"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#F20D4F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#F20D4F"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#F20D4F"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#09090A"/><Setter Property="Foreground" Value="#F5F5F5"/><Setter Property="BorderBrush" Value="#343437"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2,0,2"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#F20D4F"/><Setter Property="SelectionBrush" Value="#7A1635"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D141E"/><Setter Property="Foreground" Value="#ECF2F7"/><Setter Property="BorderBrush" Value="#344156"/><Setter Property="Padding" Value="13,12"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D4DEE9"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,10,0,10"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#D4DEE9"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,22,0"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECF2F7"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="#182331" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#31535B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECF2F7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#182331" BorderBrush="#344156" BorderThickness="1" CornerRadius="9"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter x:Name="SelectedContent" IsHitTestVisible="False" Margin="12,10,32,10" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
    <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,34,1" Padding="11,9" Background="#09090A" Foreground="#F5F5F5" BorderThickness="0" CaretBrush="#F20D4F" Text="{Binding Text,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#182331" BorderBrush="#344156" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
